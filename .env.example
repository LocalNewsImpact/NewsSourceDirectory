# Copy to .env and adjust. `make setup` does this for you if .env is missing.
# Never commit .env.

DATABASE_URL=postgres://directory:directory@localhost:5434/directory
DJANGO_SECRET_KEY=dev-only-not-a-real-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google sign-in. Leave blank locally: with no client id the admin falls back to
# a normal Django login, so a new contributor does not need OAuth credentials to
# run the project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAIN=localnewsimpact.org

# Where `publish` writes. Unset locally means "write to ./dist/feed and stop".
FEED_S3_BUCKET=
